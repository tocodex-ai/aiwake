# ============================================================
# AIwake 自主智能体配置（独立版，无需 VCPToolBox）
# 复制此文件为 .env 并填写你的实际值
# ============================================================

# 时区
DEFAULT_TIMEZONE=Asia/Shanghai

# ──────────────────────────────────────────────
# 本地小模型（Ollama，CPU 可运行，无需显卡）
# LOCAL_MODEL_ENABLED=false 时，系统不会调用 Ollama；可只使用下面的双 API 模型。
# 推荐模型（按硬件选择）：
#   16GB RAM: qwen2.5:1.5b  （最稳定）
#   32GB RAM: qwen2.5:3b    （质量更好）
# ──────────────────────────────────────────────
LOCAL_MODEL_ENABLED=true
LOCAL_MODEL=qwen2.5:1.5b

# ──────────────────────────────────────────────
# 工作/学习大模型（OpenAI 兼容接口）
# 用于用户对话、作业、学习、复杂推理和工具调用。
# ──────────────────────────────────────────────
WORK_API_URL=https://api.openai.com/v1
WORK_API_KEY=replace-with-your-work-api-key
WORK_MODEL=gpt-5.5

# ──────────────────────────────────────────────
# 心跳/反思模型（OpenAI 兼容接口）
# 用于自主反思、主动发话、用户印象摘要、旧日记压缩。
# 可以配置为更便宜/更快的模型，也可以和 WORK_* 相同。
# ──────────────────────────────────────────────
REFLECT_API_URL=https://api.openai.com/v1
REFLECT_API_KEY=replace-with-your-reflect-api-key
REFLECT_MODEL=gpt-5.5

# ──────────────────────────────────────────────
# 旧版云端大模型配置（兼容保留）
# 如果没有配置 WORK_* / REFLECT_*，系统会回退到 CLOUD_*。
# ──────────────────────────────────────────────
CLOUD_API_URL=
CLOUD_API_KEY=
CLOUD_MODEL=gpt-5.5

# ──────────────────────────────────────────────
# 日记存储目录（容器内路径，volume 挂载持久化）
# ──────────────────────────────────────────────
DIARY_DIR=/app/data/diary

# ──────────────────────────────────────────────
# 心跳配置
# ──────────────────────────────────────────────
# 心跳间隔（秒），建议 10~30
TICK_INTERVAL_SECONDS=15
# 每隔多少次 tick 做一次深度自主反思
REFLECT_EVERY_N_TICKS=20

# ──────────────────────────────────────────────
# 主动发话配置（Agent 自主找人对话）
# ──────────────────────────────────────────────
# 两次主动发话之间的最短冷却时间（秒），默认 5 分钟
PROACTIVE_COOLDOWN_SECONDS=300
# 触发主动发话所需的最低 CS 社交渴望值（0~1），默认 0.55
PROACTIVE_CS_THRESHOLD=0.55
# 距上次用户消息多久后才允许主动发话（秒），默认 2 分钟
PROACTIVE_IDLE_SECONDS=120

# ──────────────────────────────────────────────
# 预算控制（防止 API 超支）
# ──────────────────────────────────────────────
# 旧版总限制（兼容保留）
HOURLY_CLOUD_LIMIT=20
# 每小时最多调用工作/学习模型次数
HOURLY_WORK_LIMIT=20
# 每小时最多调用心跳/反思模型次数
HOURLY_REFLECT_LIMIT=60
